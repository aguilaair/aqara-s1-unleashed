    "how": "In the browser, over USB. It backs the panel up first, then roots and flashes it."
  },
  "ratings": {
    "difficulty": {
      "value": "medium",
      "detail": "Browser install, but the back cover comes off"
    },
    "reversible": {
      "value": "yes",
      "detail": "Restores the original software from the backup"
    },
    "modifiesAndroid": {
      "value": "yes",
      "detail": "Boot image patched, verified boot off"
    },
    "root": {
      "value": "required",
      "detail": "Magisk and a root helper"
    },
    "opensDevice": {
      "value": "yes",
      "detail": "To reach the FEL button"
    },
    "vendorApps": {
      "value": "disabled",
      "detail": "Aqara's apps stay installed"
    },
    "wipes": {
      "value": "no"
    },
    "backup": {
      "value": "automatic",
      "detail": "Before anything is written"
    },
    "updates": {
      "value": "ha"
    }
  },
  "ratingsNote": "Without root, the app can install over adb on its own, but you lose the radio modes."
